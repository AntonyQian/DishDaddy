# Copy to .env and fill in. Never commit .env.
# Default: Anthropic (claude-haiku-5-5). Without DETECTION_PROVIDER, the first provider with a key wins: Anthropic, OpenAI, Gemini.
# Force one with DETECTION_PROVIDER=anthropic|openai|gemini.
DETECTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PORT=8787
