# Copy to .env.local. Expo inlines EXPO_PUBLIC_* vars into the app bundle.
# Use the deployed server URL, or your computer's LAN IP for a local server
# (phones cannot reach "localhost" on your computer).
EXPO_PUBLIC_SERVER_URL=http://192.168.1.10:8787

# Set to 1 to answer Scans with a canned ScanResult (no server needed).
EXPO_PUBLIC_MOCK_SCAN=0
